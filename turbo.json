{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"tsconfig.json",
		"tsdown.config.ts",
		"fixtures/lib/Cargo.toml",
		"fixtures/lib/Cargo.lock"
	],
	"globalPassThroughEnv": [
		"PLAYWRIGHT_BROWSERS_PATH",
		"PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS"
	],
	"tasks": {
		"check": {},
		"typecheck": {
			"dependsOn": ["check"]
		},
		"build": {
			"dependsOn": ["typecheck", "^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"prepublishOnly": {
			"dependsOn": ["build"],
			"outputs": ["dist/**"]
		}
	}
}
