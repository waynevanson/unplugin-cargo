{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"packages/unplugin-cargo/tsconfig.json",
		"packages/unplugin-cargo/tsup.config.ts",
		"packages/unplugin-cargo/fixtures/lib/Cargo.toml",
		"packages/unplugin-cargo/fixtures/lib/Cargo.lock"
	],
	"globalPassThroughEnv": [
		"PLAYWRIGHT_BROWSERS_PATH",
		"PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"prepublishOnly": {
			"dependsOn": ["build"],
			"outputs": ["dist/**"]
		}
	}
}
